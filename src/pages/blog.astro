---
import Site from '../layouts/Site.astro';
import { posts } from '../data/posts';
const topics = [...new Set(posts.flatMap(post => post.topics))];
const count = (topic: string) => posts.filter(post => post.topics.includes(topic)).length;
const featured = posts[0];
---
<Site title="Blog — Rishabh Raj" description="Rishabh Raj’s writing on system design and backend engineering.">
  <main id="main"><div class="wrap">
    <header class="lead">
      <div><p class="eyebrow">// Blog</p><h1>Things I write<br/>about <i aria-hidden="true">✦</i></h1>
        <p class="intro">Notes on the decisions behind backend systems, published on LinkedIn. <a href="https://www.linkedin.com/in/rishabh-raj-1551811ab/">Follow my writing ↗</a></p>
        <p class="counts">{posts.length} {posts.length === 1 ? 'post' : 'posts'} · {topics.length} topics</p>
      </div>
      <div class="bubbles" aria-label="Browse topics">{topics.map(topic => <a class="bubble" href="#shelf" data-topic={topic}>{topic}<small>{String(count(topic)).padStart(2,'0')}</small></a>)}</div>
    </header>
    {featured && <section><p class="eyebrow">// Featured post</p><h2>Start here <i aria-hidden="true">✦</i></h2>
      <a class="feature panel" href={featured.url}>
        {featured.cover === 'redirects' && <div class="diagram" aria-hidden="true"><span>GET /short-link</span><div><b>301<small>Permanent</small></b><b>302<small>Temporary</small></b></div></div>}
        <div class="copy"><p class="eyebrow">{featured.topics[0]}</p><h3>{featured.title}</h3><p>{featured.summary}</p><strong>Read on LinkedIn ↗</strong></div>
      </a>
    </section>}
    <section id="shelf"><p class="eyebrow">// All posts</p><h2>The full shelf</h2>
      <div class="filters" aria-label="Filter posts" hidden>{['All', ...topics].map(topic => <button type="button" data-filter={topic} aria-pressed={topic==='All'}>{topic} <sup>{topic==='All'? posts.length : count(topic)}</sup></button>)}</div>
      <div class="shelf">{posts.map(post => <article class="panel" data-topics={JSON.stringify(post.topics)}><a href={post.url}><p class="eyebrow">{post.topics.join(' / ')}</p><h3>{post.title}</h3><p>{post.summary}</p><strong>Read on LinkedIn ↗</strong></a></article>)}</div>
    </section>
  </div></main>
</Site>
<script>
  const filters = document.querySelector<HTMLElement>('.filters');
  if (filters) filters.hidden = false;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  function filter(topic: string) {
    buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.filter === topic)));
    document.querySelectorAll<HTMLElement>('[data-topics]').forEach(card => {
      card.hidden = topic !== 'All' && !JSON.parse(card.dataset.topics!).includes(topic);
    });
  }
  buttons.forEach(button => button.addEventListener('click', () => filter(button.dataset.filter!)));
  document.querySelectorAll<HTMLElement>('[data-topic]').forEach(link => link.addEventListener('click', () => filter(link.dataset.topic!)));
</script>
<style>
  main{background:#101014;color:#f8f6fc;min-height:100vh;padding:clamp(40px,6vw,88px) 0}
  .lead{display:grid;grid-template-columns:1.4fr 1fr;align-items:center;gap:6%}
  .eyebrow,.counts,.filters,.intro,strong,.diagram{font-family:ui-monospace,Menlo,monospace}
  .eyebrow{color:#b99cfb;text-transform:uppercase;letter-spacing:.14em;font-size:.76rem}
  h1{font-size:clamp(3.3rem,7vw,6.6rem);line-height:.97;margin:18px 0 28px}
  i{color:#b99cfb;font-size:.63em;vertical-align:top;font-style:normal}
  .intro,.copy>p:not(.eyebrow),article p:not(.eyebrow){color:#c1bdcc;line-height:1.7}
  .intro{max-width:55ch}.intro a,strong{color:#cdb5ff}.counts{margin-top:20px;color:#c5bdcc}
  .bubbles{display:flex;justify-content:center;align-items:center;gap:10px;flex-wrap:wrap}
  .bubble{border:1.5px solid var(--tone,#ab91ef);background:color-mix(in srgb,var(--tone,#ab91ef) 17%,#131318);text-decoration:none;width:clamp(92px,8.5vw,130px);aspect-ratio:1;display:grid;align-content:center;text-align:center;justify-items:center;border-radius:50%;font-weight:700}
  .bubble:nth-child(3n+2){--tone:#77b8ff;translate:0 -18px}.bubble:nth-child(3n){--tone:#7cd4ba;translate:0 18px}.bubble small{font:500 .8rem monospace;color:var(--tone,#ab91ef)}
  section{margin-top:clamp(52px,7vw,94px);scroll-margin-top:24px}h2{font-size:clamp(2rem,4vw,3.3rem);margin:4px 0 22px}
  .panel{background:#191820;border:1px solid #373440;border-radius:16px;overflow:hidden}
  .panel:hover,.panel:focus-within,.feature:focus-visible{border-color:#b79af7}
  .feature,.panel a{color:inherit;text-decoration:none}.feature{display:grid;grid-template-columns:1fr 1.2fr}
  .copy,article a{display:block;padding:clamp(20px,3vw,38px)}
  h3{margin:10px 0;font:650 clamp(1.4rem,2.7vw,2.35rem)/1.14 var(--heading);letter-spacing:-.04em}
  strong{display:inline-block;font-size:.84rem;margin-top:20px}
  .diagram{display:grid;place-content:center;gap:22px;background:radial-gradient(ellipse at 20% 0,#463661,#211e30 80%);text-align:center;min-height:185px}
  .diagram span{color:#ded2fb}.diagram div{display:flex;gap:12px}.diagram b{border:1px solid #9988bd;border-radius:8px;padding:12px 15px;color:#ded1ff;font-size:1.45rem}.diagram small{display:block;font-size:.72rem;font-weight:400}
  .filters{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:22px}.filters[hidden]{display:none}
  button{font:inherit;font-size:.9rem;color:#bbb5c9;background:none;border:0;border-bottom:2px solid transparent;padding:8px 0;cursor:pointer}
  button[aria-pressed=true]{color:white;border-color:#b99cfb}sup{color:#b99cfb}
  .shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,310px),1fr));gap:18px}article h3{font-size:1.5rem}
  @media(prefers-reduced-motion:no-preference){.bubble{transition:transform .22s}.bubble:hover,.bubble:focus-visible{transform:translateY(-4px)}}
  @media(max-width:700px){.lead,.feature{grid-template-columns:1fr}.bubbles{justify-content:flex-start;margin:25px 0 10px}.bubble:nth-child(n){translate:0}.bubble{width:84px;font-size:.86rem}}
</style>
